# Адрес и публичный anon-ключ проекта Supabase.
# Settings → API в панели проекта. Оба значения не секретны: anon-ключ даёт
# только чтение, запись закрыта политиками RLS (см. supabase/schema.sql).
VITE_SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Базовый путь сборки. Локально не нужен; на CI подставляется автоматически.
# VITE_BASE=/shopping/
